    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^10.0.10",
    "pg": "^8.13.0",
    "pg-boss": "^12.0.0",
    "pino": "^9.5.0",
    "swagger-ui-dist": "^5.17.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^26.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.11.0",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "typescript": "~5.9.0"
