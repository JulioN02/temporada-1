# BOP v1 — environment template (secrets BLANK on purpose).
# Copy to backend/.env (or export) and fill real values. Never commit secrets.

# Runtime
NODE_ENV=development            # development | test | production
PORT=3000

# PostgreSQL (docker-compose db service on host port 55437)
DATABASE_URL=postgres://postgres:postgres@localhost:55437/bop

# Secrets — MUST be >= 32 characters (validated at boot, zod fail-fast)
JWT_SECRET=
COOKIE_SECRET=

# App version (injected as build-arg in Docker; default 'dev')
APP_VERSION=dev

# SMTP (worker-only email; dev/test uses mailpit)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=bop@localhost

# pg-boss overrides (optional — defaults are fine)
# PG_BOSS_SCHEMA=pgboss
# PG_BOSS_POLLING_INTERVAL_SECONDS=2